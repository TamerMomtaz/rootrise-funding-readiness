# RootRise Funding Readiness Dashboard (FRD) v4.0: environment
# Render: Dashboard → service → Environment. Locally: export these or use a .env loader.

# ── Core ──
DATABASE_PATH=/data/funding_readiness.db     # Render persistent disk; locally e.g. ./data/frd.db
LOG_LEVEL=INFO
CORS_ORIGINS=https://rootrise-funding-readiness.onrender.com,http://localhost:8000

# ── Access control (see README → Auth) ──
AUTH_MODE=off                 # off | writes | full. Start with off; flip after the secrets below are set
API_KEY=                      # long random string; same value goes in the Hunter's DASHBOARD_API_KEY secret
TEAM_PASSCODE=                # shared passcode the team types in the browser
AUTH_SECRET=                  # long random string used to sign browser tokens (rotate = sign everyone out)
AUTH_TOKEN_DAYS=30

# Generate random values with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
